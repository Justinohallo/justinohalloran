{
  "name": "justinohalloran",
  "private": true,
  "description": "Portfolio of Justin O'Halloran, senior frontend engineer. Next.js, TypeScript, a token-driven design system with Storybook.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "pnpm tokens && next dev",
    "build": "pnpm tokens && pnpm storybook:build && next build",
    "start": "next start",
    "typecheck": "pnpm tokens && tsc --noEmit",
    "storybook": "pnpm tokens && storybook dev -p 6006",
    "storybook:build": "storybook build -o public/storybook --quiet --disable-telemetry"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
